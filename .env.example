# Copy this file to .env when you need local environment overrides.
# The default development setup uses the on-premise MySQL database.

FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5241

MYSQL_CONNECTION_STRING=Server=127.0.0.1;Port=3306;User ID=root;Password=root_native;Database=db_production_control;SslMode=None;AllowPublicKeyRetrieval=True;

JWT_ISSUER=ProductionControl
JWT_AUDIENCE=ProductionControl.Frontend
JWT_SIGNING_KEY=replace-with-a-long-random-production-secret
JWT_EXPIRES_HOURS=8

SWAGGER_ENABLED=true
